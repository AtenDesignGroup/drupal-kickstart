# Environment Configuration for Playwright VRT Tests

# Base URL for the site to test
# Local DDEV: https://atend8.ddev.site
# Pantheon Dev: https://dev-atend8.pantheonsite.io
# Production: https://atendesigngroup.com
BASE_URL=https://atendesigngroup.com

# Pantheon site name (used for Terminus commands in CI)
# Format: site-name (without environment)
PANTHEON_SITE=aten-io

# Pantheon environment to test against in CI
# Options: dev, test, live, or multidev name
PANTHEON_ENV=dev

# CI flag (automatically set by GitHub Actions)
# Set to 'true' or '1' to use Terminus instead of DDEV
# CI=true
