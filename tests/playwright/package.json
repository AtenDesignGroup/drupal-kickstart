{
  "name": "playwright-vrt",
  "version": "1.0.0",
  "description": "Standalone Playwright visual regression tests for Aten top navigation.",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:e2e": "npx playwright test --project=e2e",
    "test:vrt": "npx playwright test tests/vrt/specs",
    "test:vrt:baseline": "npx playwright test tests/vrt/specs --update-snapshots",
    "test:a11y": "npx playwright test --project=a11y",
    "test:live": "npx playwright test --project=live",
    "test:headed": "npx playwright test --headed --project=e2e",
    "test:debug": "npx playwright test --debug --project=e2e",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report"
  },
  "author": "AtenDesignGroup",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.58.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.10.1",
    "dotenv": "^17.2.3"
  }
}
