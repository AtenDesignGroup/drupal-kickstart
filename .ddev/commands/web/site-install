#!/bin/bash
## Description: Install Drupal using drush site:install with project defaults.
## Usage: site-install [flags] [args]
## Example: "site-install"
## Example: "site-install --site-name=mysite --account-pass=secret"

# Defaults — can be overridden by passing flags
SITE_NAME="${SITE_NAME:-${PROJECT_NAME:-Drupal}}"
ACCOUNT_NAME="${ACCOUNT_NAME:-admin}"
ACCOUNT_PASS="${ACCOUNT_PASS:-admin}"

drush site:install minimal \
  --yes \
  --site-name="${SITE_NAME}" \
  --account-name="${ACCOUNT_NAME}" \
  --account-pass="${ACCOUNT_PASS}" \
  "$@"
