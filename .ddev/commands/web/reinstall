#!/usr/bin/env bash
## Description: Reinstall Drupal from scratch and re-apply all base recipes.
## Usage: reinstall [--yes]
## Example: "ddev reinstall"
## Example: "ddev reinstall --yes"

set -euo pipefail

BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
CYAN="\033[0;36m"
RED="\033[0;31m"
RESET="\033[0m"

trap 'echo -e "\n${RED}${BOLD}reinstall failed.${RESET}" >&2' ERR

header() { echo -e "\n${BOLD}${CYAN}==> $1${RESET}"; }
info()   { echo -e "    ${GREEN}✔${RESET} $1"; }
warn()   { echo -e "    ${YELLOW}⚠${RESET}  $1"; }

# ─── Args ────────────────────────────────────────────────────────────────────
SKIP_CONFIRM="no"
for arg in "$@"; do
  case "$arg" in
    --yes|-y) SKIP_CONFIRM="yes" ;;
  esac
done

# ─── Load project values ─────────────────────────────────────────────────────
ENV_FILE="/var/www/html/.kickstart.env"
SECRETS_FILE="/var/www/html/.env"

if [[ ! -f "$ENV_FILE" ]]; then
  warn ".kickstart.env not found — collecting required values now."
  echo

  # Prompt for the minimum values reinstall needs.
  DEFAULT_NAME="$(basename /var/www/html)"
  read -r -p "$(echo -e "  ${BOLD}Project name (DDEV)${RESET} [${CYAN}${DEFAULT_NAME}${RESET}]: ")" _name
  DK_DDEV_NAME="${_name:-$DEFAULT_NAME}"

  read -r -p "$(echo -e "  ${BOLD}Theme machine name${RESET} (leave blank if none): ")" _theme
  DK_THEME_NAME="${_theme:-}"

  read -r -p "$(echo -e "  ${BOLD}PHP version${RESET} [${CYAN}8.3${RESET}]: ")" _php
  DK_PHP_VERSION="${_php:-8.3}"

  cat > "$ENV_FILE" <<EOF
# Drupal Kickstart — saved configuration
# Generated by ddev reinstall: $(date)
DK_DDEV_NAME="${DK_DDEV_NAME}"
DK_THEME_NAME="${DK_THEME_NAME}"
DK_THEME_DESC="${DK_THEME_NAME}"
DK_THEME_ABBREVIATED=""
DK_USES_PANTHEON="no"
DK_USES_SOLR="no"
DK_COMMIT_PREFIX=""
DK_PHP_VERSION="${DK_PHP_VERSION}"
DK_NODE_VERSION="22"
EOF
  info ".kickstart.env created at ${ENV_FILE}"
fi

# shellcheck source=.kickstart.env
source "$ENV_FILE"

if [[ ! -f "$SECRETS_FILE" ]]; then
  warn ".env (secrets) not found — generating fresh credentials."
  DK_DRUPAL_HASH_SALT=$(openssl rand -base64 48 | tr -d '=+/' | head -c 64)
  DK_DRUPAL_ADMIN_USERNAME="admin"
  DK_DRUPAL_ADMIN_PASSWORD=$(openssl rand -base64 24 | tr -d '=+/')
  cat > "$SECRETS_FILE" <<EOF
# Drupal Kickstart — secrets
# Generated by ddev reinstall: $(date)
# ⚠ Do NOT commit this file.
DK_DRUPAL_HASH_SALT="${DK_DRUPAL_HASH_SALT}"
DK_DRUPAL_ADMIN_USERNAME="${DK_DRUPAL_ADMIN_USERNAME}"
DK_DRUPAL_ADMIN_PASSWORD="${DK_DRUPAL_ADMIN_PASSWORD}"
EOF
  info "Fresh credentials written to .env (admin / ${DK_DRUPAL_ADMIN_PASSWORD})"
fi

# shellcheck source=.env
source "$SECRETS_FILE"

ADMIN_USER="${DK_DRUPAL_ADMIN_USERNAME:-admin}"
ADMIN_PASS="${DK_DRUPAL_ADMIN_PASSWORD:-admin}"
THEME_NAME="${DK_THEME_NAME:-}"

# ─── Redis guard ─────────────────────────────────────────────────────────────
# REDIS_ENABLED=true is set in .ddev/config.yaml by setup-pantheon. During a
# fresh install the redis module is not yet present, so Drupal's container will
# fail with "non-existent service cache.backend.redis". Each drush/recipe call
# below passes REDIS_ENABLED=false inline — export does not reliably propagate
# through DDEV's container environment into child bash scripts.
REDIS_BYPASS=""
if [[ "${REDIS_ENABLED:-}" == "true" ]]; then
  warn "REDIS_ENABLED=true detected — bypassing Redis for install"
  REDIS_BYPASS="REDIS_ENABLED=false"
fi

# ─── Confirm ─────────────────────────────────────────────────────────────────
echo
echo -e "${YELLOW}${BOLD}WARNING: This will drop and recreate the database, reinstall Drupal, and"
echo -e "re-apply formula-foundational. All content and config changes will be lost.${RESET}"
echo
echo -e "    ${BOLD}Site              :${RESET} ${DK_DDEV_NAME:-unknown}"
echo -e "    ${BOLD}Theme             :${RESET} ${THEME_NAME:-unknown}"
echo -e "    ${BOLD}Admin user        :${RESET} ${ADMIN_USER}"
echo

if [[ "$SKIP_CONFIRM" != "yes" ]]; then
  read -r -p "$(echo -e "  ${BOLD}Proceed?${RESET} [${CYAN}y/N${RESET}]: ")" _confirm
  _confirm="${_confirm:-N}"
  if [[ ! "$_confirm" =~ ^[Yy] ]]; then
    echo -e "${YELLOW}Cancelled.${RESET}"
    exit 0
  fi
fi

# =============================================================================
# 1. FRESH SITE INSTALL
# =============================================================================
header "Running fresh site install (minimal profile)"

mkdir -p /var/www/html/config/sync
info "Config sync directory ensured"

SITE_NAME="${DK_DDEV_NAME}" \
ACCOUNT_NAME="${ADMIN_USER}" \
ACCOUNT_PASS="${ADMIN_PASS}" \
  env ${REDIS_BYPASS} bash /var/www/html/.ddev/commands/web/site-install minimal
info "Drupal installed"

# =============================================================================
# 2. RESTORE SETTINGS FILES
# =============================================================================
header "Restoring settings.php include"

HASH_SALT="${DK_DRUPAL_HASH_SALT:-}"
if [[ -n "$HASH_SALT" ]]; then
  bash /var/www/html/.ddev/commands/web/setup-settings --hash-salt="${HASH_SALT}"
  info "settings.php restored"
else
  warn "DK_DRUPAL_HASH_SALT not set in .env — skipping settings.ddev.php write"
fi

# =============================================================================
# 3. ENABLE THEME (if set and exists on disk)
# =============================================================================
if [[ -n "$THEME_NAME" ]]; then
  THEME_PATH="/var/www/html/web/themes/custom/${THEME_NAME}"
  if [[ -d "$THEME_PATH" ]]; then
    header "Re-enabling theme '${THEME_NAME}'"
    # Theme enable is deferred to after recipe so that its module deps are present.
    DEFER_THEME="yes"
  else
    warn "Theme directory not found at ${THEME_PATH} — theme will not be enabled"
    DEFER_THEME="no"
  fi
else
  DEFER_THEME="no"
fi

# =============================================================================
# 4. APPLY BASE RECIPE
# =============================================================================
header "Applying formula-foundational"
env ${REDIS_BYPASS} bash /var/www/html/.ddev/commands/web/recipe formula-foundational
info "formula-foundational applied"

# Uninstall Stark (enabled by minimal profile)
env ${REDIS_BYPASS} drush theme:uninstall stark --yes 2>/dev/null || true

# =============================================================================
# 4b. PANTHEON RECIPE (if configured)
# Must run before cache clear so the redis module is installed and
# settings.ddev.redis.php can resolve cache.backend.redis / redis.factory.
# =============================================================================
if [[ "${DK_USES_PANTHEON:-no}" == "yes" ]]; then
  header "Applying formula-pantheon (installs redis module)"
  env ${REDIS_BYPASS} bash /var/www/html/.ddev/commands/web/recipe formula-pantheon
  info "formula-pantheon applied — Redis module now installed"
  # From this point Redis is available; clear the bypass so subsequent drush
  # calls (theme install, cr) run with the real Redis backend.
  REDIS_BYPASS=""
fi

# =============================================================================
# 5. ENABLE THEME (deferred from § 3)
# =============================================================================
if [[ "${DEFER_THEME:-no}" == "yes" ]]; then
  header "Enabling theme '${THEME_NAME}'"
  env ${REDIS_BYPASS} drush theme:install "${THEME_NAME}" --yes
  env ${REDIS_BYPASS} drush config:set system.theme default "${THEME_NAME}" --yes
  env ${REDIS_BYPASS} drush cr
  info "Theme '${THEME_NAME}' set as default"
fi

# =============================================================================
# 6. FINAL CACHE CLEAR
# =============================================================================
env ${REDIS_BYPASS} drush cr
info "Caches cleared"

# ─── Done ────────────────────────────────────────────────────────────────────
echo
echo -e "${GREEN}${BOLD}============================================================${RESET}"
echo -e "${GREEN}${BOLD}  Reinstall complete!${RESET}"
echo -e "${GREEN}${BOLD}============================================================${RESET}"
echo
echo -e "  ${BOLD}URL      :${RESET} https://${DK_DDEV_NAME}.ddev.site"
echo -e "  ${BOLD}Login    :${RESET} ${ADMIN_USER} / ${ADMIN_PASS}"
echo
echo -e "  ${YELLOW}Re-apply optional recipes with:${RESET} ${BOLD}ddev recipe${RESET}"
echo
