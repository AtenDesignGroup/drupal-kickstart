#!/usr/bin/env bash

## Description: Apply a local recipe by merging dependencies and running recipe
## Usage: recipe [recipe-name]
## Example: ddev recipe formula-foundational

set -e

# Exclude list - recipes to skip in interactive mode
EXCLUDE_LIST=("formula-foundational")

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_info() {
    echo -e "${BLUE}ℹ${NC} $1"
}

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

# Function to check if recipe is in exclude list
is_excluded() {
    local recipe=$1
    for excluded in "${EXCLUDE_LIST[@]}"; do
        if [ "$recipe" = "$excluded" ]; then
            return 0
        fi
    done
    return 1
}

# Function to get recipe display name from recipe.yml
get_recipe_display_name() {
    local recipe_path=$1
    if [ -f "$recipe_path/recipe.yml" ]; then
        local name=$(grep -E "^name:" "$recipe_path/recipe.yml" | sed 's/name:\s*//' | tr -d '"' | tr -d "'")
        if [ -n "$name" ]; then
            echo "$name"
        else
            basename "$recipe_path"
        fi
    else
        basename "$recipe_path"
    fi
}

# Function to substitute DK_* tokens in recipe.yml if .kickstart.env exists
substitute_recipe_tokens() {
    local recipe_yml=$1
    local env_file="/var/www/html/.kickstart.env"

    # Check if recipe.yml exists
    if [ ! -f "$recipe_yml" ]; then
        return 0
    fi

    # Check if recipe.yml contains any DK_* tokens
    if ! grep -q "DK_" "$recipe_yml" 2>/dev/null; then
        return 0
    fi

    # Check if .kickstart.env exists
    if [ ! -f "$env_file" ]; then
        return 0
    fi

    # Source environment variables from .kickstart.env
    # shellcheck source=/dev/null
    source "$env_file"

    # Perform token substitution using sed (matching drupal-kickstart.sh §8 pattern)
    print_info "Applying token substitution from .kickstart.env"
    sed -i.bak \
        -e "s|DK_DDEV_NAME|${DK_DDEV_NAME}|g" \
        -e "s|DK_THEME_NAME|${DK_THEME_NAME}|g" \
        -e "s|DK_THEME_DESC|${DK_THEME_DESC}|g" \
        -e "s|DK_THEME_PATH|${DK_THEME_PATH}|g" \
        -e "s|DK_PHP_VERSION|${DK_PHP_VERSION}|g" \
        -e "s|DK_COMMIT_PREFIX|${DK_COMMIT_PREFIX:-PROJ}|g" \
        "$recipe_yml" && rm -f "${recipe_yml}.bak"

    return 0
}

# Recursively collect all entries from `install:` blocks across a recipe tree.
# Outputs one module name per line.
collect_install_modules() {
    local recipe_name=$1
    local -n _ci_visited=$2
    local recipes_dir="/var/www/html/recipes"
    local recipe_path="${recipes_dir}/${recipe_name}"

    if [[ -v "_ci_visited[$recipe_name]" ]]; then
        return 0
    fi
    _ci_visited[$recipe_name]=1

    if [ -f "${recipe_path}/recipe.yml" ]; then
        # Recurse into sub-recipes first.
        local sub_recipes
        sub_recipes=$(grep -E '^\s+-\s+formula-' "${recipe_path}/recipe.yml" 2>/dev/null \
            | sed 's/^\s*-\s*//' | tr -d "'" | tr -d '"' || true)
        for sub in $sub_recipes; do
            collect_install_modules "$sub" "$2"
        done

        # Emit install: entries — lines that are list items under the install block.
        awk '/^install:/{p=1;next} p && /^[^ ]/{p=0} p && /^\s+-/{gsub(/^\s+-\s*/,""); print}' \
            "${recipe_path}/recipe.yml" 2>/dev/null || true
    fi
}

# Recursively collect composer deps from a recipe and all its sub-recipes.
# Outputs a space-separated list of "package:version" strings.
# Visited set (passed as a nameref array) prevents infinite loops.
collect_deps() {
    local recipe_name=$1
    local -n _visited=$2   # nameref to caller's associative array
    local recipes_dir="/var/www/html/recipes"
    local recipe_path="${recipes_dir}/${recipe_name}"

    # Guard against cycles and recipes we've already processed.
    if [[ -v "_visited[$recipe_name]" ]]; then
        return 0
    fi
    _visited[$recipe_name]=1

    # Recurse into sub-recipes listed under `recipes:` in recipe.yml first.
    if [ -f "${recipe_path}/recipe.yml" ]; then
        local sub_recipes
        sub_recipes=$(grep -E '^\s+-\s+formula-' "${recipe_path}/recipe.yml" 2>/dev/null \
            | sed 's/^\s*-\s*//' | tr -d "'" | tr -d '"' || true)
        for sub in $sub_recipes; do
            collect_deps "$sub" "$2"
        done
    fi

    # Emit this recipe's own composer deps.
    if [ -f "${recipe_path}/composer.json" ]; then
        jq -r '.require // {} | to_entries[] | "\(.key):\(.value)"' \
            "${recipe_path}/composer.json" 2>/dev/null || true
    fi
}

# Function to apply a single recipe
apply_recipe() {
    local RECIPE_NAME=$1
    local RECIPE_PATH="/var/www/html/recipes/$RECIPE_NAME"
    local ROOT_COMPOSER="/var/www/html/composer.json"

    # Substitute tokens before validation if .kickstart.env exists and tokens are present
    substitute_recipe_tokens "$RECIPE_PATH/recipe.yml"

    print_info "Starting recipe application: $RECIPE_NAME"
    echo ""

    # Step 1: Validate recipe exists
    print_info "Step 1/5: Validating recipe..."
    if [ ! -d "$RECIPE_PATH" ]; then
        print_error "Recipe directory not found: recipes/$RECIPE_NAME"
        return 1
    fi

    if [ ! -f "$RECIPE_PATH/recipe.yml" ]; then
        print_error "recipe.yml not found in: recipes/$RECIPE_NAME"
        return 1
    fi

    print_success "Recipe validated: $RECIPE_PATH"
    echo ""

    # Step 2: Merge dependencies — recursively collect from this recipe and all sub-recipes
    print_info "Step 2/5: Merging composer dependencies (including sub-recipes)..."

    # Ensure jq is installed
    if ! command -v jq &> /dev/null; then
        print_warning "jq not found, attempting to install..."
        apt-get update -qq && apt-get install -y -qq jq > /dev/null 2>&1
    fi

    declare -A _seen_recipes=()
    # Collect all deps from the full recipe tree (deduped by sort -u)
    RECIPE_DEPS=$(collect_deps "$RECIPE_NAME" _seen_recipes \
        | grep -v '^drupal-recipe-unpack\|^composer/' \
        | sort -u \
        | tr '\n' ' ')

    if [ -n "$RECIPE_DEPS" ] && [ "$RECIPE_DEPS" != " " ]; then
        print_info "Found dependencies to merge across recipe tree: $(echo "$RECIPE_DEPS" | wc -w | tr -d ' ') packages"
        print_warning "This may take a few minutes..."

        # Use composer require to add all dependencies
        if composer require $RECIPE_DEPS --working-dir=/var/www/html --no-interaction; then
            print_success "Dependencies merged and installed"
        else
            print_error "Failed to install dependencies"
            return 1
        fi
    else
        print_warning "No require dependencies found in recipe tree"
    fi

    # Dev deps from the top-level recipe only (sub-recipe dev deps are not inherited)
    if [ -f "$RECIPE_PATH/composer.json" ]; then
        RECIPE_DEV_DEPS=$(jq -r '."require-dev" // {} | to_entries | map("\(.key):\(.value)") | join(" ")' \
            "$RECIPE_PATH/composer.json")
        if [ -n "$RECIPE_DEV_DEPS" ] && [ "$RECIPE_DEV_DEPS" != "" ]; then
            print_info "Found dev dependencies: $(echo "$RECIPE_DEV_DEPS" | wc -w | tr -d ' ') packages"
            if composer require --dev $RECIPE_DEV_DEPS --working-dir=/var/www/html --no-interaction; then
                print_success "Dev dependencies merged and installed"
            else
                print_warning "Failed to install dev dependencies (continuing anyway)"
            fi
        fi
    fi
    echo ""

    # Step 2b: Pre-flight — verify every contrib module in install: blocks is on disk
    print_info "Step 2b/5: Verifying module availability..."
    declare -A _ci_seen=()
    MISSING_MODS=()
    # Core modules are in web/core/modules — anything not there must be contrib.
    while IFS= read -r mod; do
        mod=$(echo "$mod" | xargs)  # trim whitespace
        [[ -z "$mod" ]] && continue
        # Skip if already in core.
        if [ -d "/var/www/html/web/core/modules/$mod" ]; then
            continue
        fi
        # Check contrib path.
        if [ ! -d "/var/www/html/web/modules/contrib/$mod" ]; then
            MISSING_MODS+=("$mod")
        fi
    done < <(collect_install_modules "$RECIPE_NAME" _ci_seen | sort -u)

    if [ ${#MISSING_MODS[@]} -gt 0 ]; then
        print_error "The following modules are listed in install: but not found on disk:"
        for m in "${MISSING_MODS[@]}"; do
            echo "  • $m  (missing from web/modules/contrib/$m)"
        done
        echo ""
        print_error "Add the missing package(s) to the recipe's composer.json and re-run."
        return 1
    fi
    print_success "All install: modules are available on disk"
    echo ""

    # Step 3: Clear Drupal cache
    print_info "Step 3/5: Clearing Drupal cache..."
    cd /var/www/html/web
    if drush cache:rebuild > /dev/null 2>&1; then
        print_success "Cache cleared"
    else
        print_warning "Could not clear cache (site may not be installed yet)"
    fi
    echo ""

    # Step 4: Apply recipe with Drush
    print_info "Step 4/5: Applying recipe with Drush..."
    print_warning "This will install modules, import configuration, and apply config actions..."
    echo ""

    cd /var/www/html/web
    if drush recipe "../recipes/$RECIPE_NAME"; then
        echo ""
        print_success "Recipe applied successfully!"
        echo ""
        print_info "Summary:"
        if [ -f "$RECIPE_PATH/composer.json" ]; then
            echo "  • Dependencies from recipes/$RECIPE_NAME/composer.json merged into root composer.json"
        fi
        echo "  • Recipe configuration applied"
        echo "  • Modules and themes installed"
        echo "  • Config imported and actions executed"
    else
        print_error "Failed to apply recipe with Drush"
        return 1
    fi

    echo ""
    print_info "Step 5/5: Complete!"
    return 0
}

# Interactive mode or direct recipe application
if [ -z "$1" ]; then
    # Interactive mode - list all recipes
    print_info "Available recipes:"
    echo ""
    
    RECIPES_DIR="/var/www/html/recipes"
    RECIPE_LIST=()
    RECIPE_INDEX=0
    
    # Build list of non-excluded recipes
    for recipe_dir in "$RECIPES_DIR"/*/; do
        if [ -d "$recipe_dir" ]; then
            recipe_name=$(basename "$recipe_dir")
            
            # Skip if excluded
            if is_excluded "$recipe_name"; then
                continue
            fi
            
            # Only include if recipe.yml exists
            if [ -f "$recipe_dir/recipe.yml" ]; then
                RECIPE_LIST+=("$recipe_name")
                display_name=$(get_recipe_display_name "$recipe_dir")
                echo "  [$RECIPE_INDEX] $recipe_name - $display_name"
                RECIPE_INDEX=$((RECIPE_INDEX + 1))
            fi
        fi
    done
    
    if [ ${#RECIPE_LIST[@]} -eq 0 ]; then
        echo ""
        print_error "No recipes found in recipes/"
        exit 1
    fi
    
    echo ""
    echo "Enter recipe number(s) separated by commas (e.g., 0,2,4) or 'q' to quit:"
    read -r selection
    
    if [ "$selection" = "q" ] || [ "$selection" = "Q" ]; then
        echo "Cancelled"
        exit 0
    fi
    
    # Parse comma-separated selections
    IFS=',' read -ra SELECTIONS <<< "$selection"
    FAILED_RECIPES=()
    
    for sel in "${SELECTIONS[@]}"; do
        # Trim whitespace
        sel=$(echo "$sel" | xargs)
        
        # Validate selection is a number
        if ! [[ "$sel" =~ ^[0-9]+$ ]]; then
            print_error "Invalid selection: $sel"
            continue
        fi
        
        # Check if selection is in range
        if [ "$sel" -lt 0 ] || [ "$sel" -ge ${#RECIPE_LIST[@]} ]; then
            print_error "Selection out of range: $sel (valid: 0-$((${#RECIPE_LIST[@]} - 1)))"
            continue
        fi
        
        RECIPE_NAME="${RECIPE_LIST[$sel]}"
        echo ""
        echo "=========================================="
        echo "Applying recipe [$sel]: $RECIPE_NAME"
        echo "=========================================="
        echo ""
        
        if ! apply_recipe "$RECIPE_NAME"; then
            FAILED_RECIPES+=("$RECIPE_NAME")
        fi
    done
    
    # Report any failures
    if [ ${#FAILED_RECIPES[@]} -gt 0 ]; then
        echo ""
        print_error "Failed to apply ${#FAILED_RECIPES[@]} recipe(s):"
        for failed in "${FAILED_RECIPES[@]}"; do
            echo "  • $failed"
        done
        exit 1
    fi
    
    exit 0
fi

# Direct recipe name provided
RECIPE_NAME="$1"

if apply_recipe "$RECIPE_NAME"; then
    exit 0
else
    exit 1
fi
