#!/bin/bash
## Description: Run Playwright live smoke tests against production.
## Usage: test:live [flags] [args]
## Example: "test:live"
## Example: "test:live --last-failed"
## Example: "BASE_URL=https://raleighnc.ddev.site test:live"
cd "${DDEV_APPROOT}/tests/playwright" && BASE_URL=${BASE_URL:-https://raleighnc.gov} npm run test:live -- $@
