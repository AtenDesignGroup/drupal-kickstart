#!/usr/bin/env bash
## Description: Set up Pantheon integration: copy assets, apply recipe, configure DDEV & Composer.
## Usage: setup-pantheon [--php-version=VERSION]
## Example: "ddev setup-pantheon" or "ddev setup-pantheon --php-version=8.3"

set -euo pipefail

# -----------------------------------------------------------------------------
# Colors / styling
# -----------------------------------------------------------------------------
BOLD="\033[1m"
GREEN="\033[0;32m"
YELLOW="\033[0;33m"
CYAN="\033[0;36m"
RED="\033[0;31m"
RESET="\033[0m"

trap 'echo -e "\n${RED}${BOLD}setup-pantheon failed.${RESET} Check messages above." >&2' ERR

header() { echo -e "\n${BOLD}${CYAN}==> $1${RESET}"; }
info()   { echo -e "    ${GREEN}✔${RESET} $1"; }
warn()   { echo -e "    ${YELLOW}⚠${RESET}  $1"; }

# -----------------------------------------------------------------------------
# Arguments
# -----------------------------------------------------------------------------
PHP_VERSION="8.3"
for arg in "$@"; do
  case "$arg" in
    --php-version=*) PHP_VERSION="${arg#*=}" ;;
  esac
done

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
PROJECT_ROOT="${DDEV_APPROOT}"
DDEV_CONFIG="${PROJECT_ROOT}/.ddev/config.yaml"
ASSETS="${PROJECT_ROOT}/assets/pantheon"

if [[ ! -d "$ASSETS" ]]; then
  echo -e "${RED}${BOLD}Error:${RESET} assets/pantheon/ not found at ${ASSETS}."
  exit 1
fi

# =============================================================================
# 1. COMPOSER PACKAGES (via formula-pantheon recipe)
# =============================================================================
header "Installing Pantheon Composer packages"

# Allow drupal-integrations scaffold files before requiring it
ddev composer config --json extra.allowed-packages '["pantheon-systems/drupal-integrations"]'
info "extra.allowed-packages set for pantheon-systems/drupal-integrations"

# =============================================================================
# 2. COPY FILES
# =============================================================================
header "Copying Pantheon asset files"

# pantheon.yml → project root
if [[ ! -f "${PROJECT_ROOT}/pantheon.yml" ]]; then
  cp "${ASSETS}/pantheon.yml" "${PROJECT_ROOT}/pantheon.yml"
  sed -i.bak "s/^php_version:.*/php_version: ${PHP_VERSION}/" "${PROJECT_ROOT}/pantheon.yml" \
    && rm -f "${PROJECT_ROOT}/pantheon.yml.bak"
  info "pantheon.yml → / (PHP ${PHP_VERSION})"
else
  warn "pantheon.yml already exists — skipped"
fi

# quicksilver → web/private/pantheon/quicksilver
QS_SRC="${ASSETS}/quicksilver"
QS_DEST="${PROJECT_ROOT}/web/private/pantheon/quicksilver"
if [[ ! -d "$QS_DEST" ]]; then
  mkdir -p "$QS_DEST"
  cp -r "${QS_SRC}/." "$QS_DEST/"
  info "quicksilver → web/private/pantheon/quicksilver"
else
  warn "web/private/pantheon/quicksilver already exists — skipped"
fi

# pantheon_secrets → private/pantheon_secrets
SECRETS_SRC="${ASSETS}/pantheon_secrets"
SECRETS_DEST="${PROJECT_ROOT}/private/pantheon_secrets"
if [[ ! -d "$SECRETS_DEST" ]]; then
  mkdir -p "$SECRETS_DEST"
  cp -r "${SECRETS_SRC}/." "$SECRETS_DEST/"
  info "pantheon_secrets → private/pantheon_secrets"
else
  warn "private/pantheon_secrets already exists — skipped"
fi

# =============================================================================
# 3. APPLY RECIPE
# =============================================================================
ddev recipe formula-pantheon

# =============================================================================
# 4. PREPARE SETTINGS.PHP FOR PANTHEON
# These one-time setup tasks ensure settings.php is ready for both local dev
# and Pantheon deployment. All steps are idempotent.
# =============================================================================
header "Preparing settings.php for Pantheon"

SETTINGS="${PROJECT_ROOT}/web/sites/default/settings.php"

# Ensure settings.php exists (Drupal scaffold may .gitignore it)
if [[ ! -f "$SETTINGS" ]]; then
  mkdir -p "$(dirname "$SETTINGS")"
  cat > "$SETTINGS" <<'SETTINGSPHP'
<?php

/**
 * @file
 * Drupal site configuration.
 */
SETTINGSPHP
  info "Created minimal settings.php (was absent)"
fi

# Verify settings.pantheon.php exists in vendor (installed via recipe)
PANTHEON_PHP="${PROJECT_ROOT}/vendor/pantheon-systems/drupal-integrations/assets/settings.pantheon.php"
if [[ ! -f "$PANTHEON_PHP" ]]; then
  echo -e "${RED}${BOLD}Error:${RESET} $PANTHEON_PHP not found"
  echo "  → Is pantheon-systems/drupal-integrations installed?"
  exit 1
fi

# Copy settings.pantheon.php to sites/default for local development
# This file will be in .gitignore (not committed), but will be available
# on Pantheon via the workflow's composer install + vendor/ commit
DEST="${PROJECT_ROOT}/web/sites/default/settings.pantheon.php"
if [[ ! -f "$DEST" ]]; then
  cp "$PANTHEON_PHP" "$DEST"
  info "Copied settings.pantheon.php to sites/default/"
else
  warn "settings.pantheon.php already exists in sites/default/ — skipped"
fi

# Insert settings.pantheon.php include at the top of settings.php (idempotent)
# Place it right after the file docblock so it loads before any other settings
if ! grep -q "settings.pantheon.php" "$SETTINGS"; then
  # Insert after the FIRST closing */ of the file docblock only
  # Use range 1,/pattern/ to match only the first occurrence
  sed -i.bak '1,/^ \*\/$/{/^ \*\/$/a\
\
/**\
 * Include the Pantheon-specific settings file.\
 *\
 * n.b. The settings.pantheon.php file makes some changes\
 *      that affect all environments that this site\
 *      exists in.  Always include this file, even in\
 *      a local development environment, to ensure that\
 *      the site settings remain consistent.\
 */\
include __DIR__ . "/settings.pantheon.php";\

}' "$SETTINGS" && rm -f "${SETTINGS}.bak"
  info "Added settings.pantheon.php include at top of settings.php"
else
  warn "settings.pantheon.php include already present — skipped"
fi

# Generate hash_salt if empty (Pantheon's read-only filesystem requires it pre-generated)
if grep -q "\$settings\['hash_salt'\] = '';" "$SETTINGS"; then
  SALT=$(ddev exec php -r "echo str_replace(['+', '/', '='], ['-', '_', ''], base64_encode(random_bytes(55)));")
  # Use | as sed delimiter to avoid conflicts with / in the salt
  sed -i.bak "s|\\\$settings\['hash_salt'\] = '';|\$settings['hash_salt'] = '$SALT';|" "$SETTINGS" \
    && rm -f "${SETTINGS}.bak"
  info "Generated and set hash_salt in settings.php"
else
  warn "hash_salt already set — skipped"
fi

# Comment out $databases declarations from settings.php
# Pantheon injects the correct database config via settings.pantheon.php
# Commenting preserves the original line for reference while disabling it
if grep -q '^\$databases' "$SETTINGS"; then
  sed -i.bak 's/^\$databases/\/\/ $databases/' "$SETTINGS" \
    && rm -f "${SETTINGS}.bak"
  info "Commented out \$databases declaration in settings.php"
else
  warn "No \$databases declaration found — skipped"
fi

# Update .gitignore to exclude DDEV-specific files (never commit)
DDEV_SETTINGS_ENTRY="web/sites/default/settings.ddev.php"
PANTHEON_SETTINGS_ENTRY="web/sites/default/settings.pantheon.php"

if ! grep -qxF "$DDEV_SETTINGS_ENTRY" "${PROJECT_ROOT}/.gitignore" 2>/dev/null; then
  echo "$DDEV_SETTINGS_ENTRY" >> "${PROJECT_ROOT}/.gitignore"
  info "Added $DDEV_SETTINGS_ENTRY to .gitignore"
else
  warn "$DDEV_SETTINGS_ENTRY already in .gitignore — skipped"
fi

if ! grep -qxF "$PANTHEON_SETTINGS_ENTRY" "${PROJECT_ROOT}/.gitignore" 2>/dev/null; then
  echo "$PANTHEON_SETTINGS_ENTRY" >> "${PROJECT_ROOT}/.gitignore"
  info "Added $PANTHEON_SETTINGS_ENTRY to .gitignore"
else
  warn "$PANTHEON_SETTINGS_ENTRY already in .gitignore — skipped"
fi

# Remove settings.php from .gitignore so it can be committed for Pantheon
# Drupal scaffold excludes it by default, but Pantheon needs it in the repo
sed -i.bak '/^web\/sites\/default\/settings\.php$/d; /^sites\/default\/settings\.php$/d' "${PROJECT_ROOT}/.gitignore" \
  && rm -f "${PROJECT_ROOT}/.gitignore.bak"
info "Ensured settings.php is not excluded by .gitignore"

# =============================================================================
# 5. UPDATE DDEV CONFIG (web_environment)
# Adds REDIS_ENABLED=true and CUSTOMER_SECRETS_FAKE_FILE.
# REDIS_ENABLED must be set AFTER the recipe installs the redis module —
# settings.ddev.php gates cache.backend.redis on this variable so that
# Drupal does not try to load the service before the module is installed.
# =============================================================================
header "Updating .ddev/config.yml"

SECRETS_ENV_VALUE="CUSTOMER_SECRETS_FAKE_FILE=/var/www/html/private/pantheon_secrets/secrets.json"

if ! grep -q "CUSTOMER_SECRETS_FAKE_FILE" "$DDEV_CONFIG"; then
  python3 - "$DDEV_CONFIG" "$SECRETS_ENV_VALUE" <<'PYEOF'
import sys, re

config_file = sys.argv[1]
entry = "  - " + sys.argv[2]
text = open(config_file).read()

if re.search(r'^web_environment:', text, re.MULTILINE):
    # Insert the new entry after the web_environment: line
    text = re.sub(
        r'(^web_environment:)',
        r'\1\n' + entry,
        text,
        flags=re.MULTILINE
    )
else:
    text += f'\nweb_environment:\n{entry}\n'

open(config_file, 'w').write(text)
PYEOF
  info "CUSTOMER_SECRETS_FAKE_FILE added to web_environment"
else
  warn "CUSTOMER_SECRETS_FAKE_FILE already in web_environment — skipped"
fi

REDIS_ENV_VALUE="REDIS_ENABLED=true"

if ! grep -q "REDIS_ENABLED" "$DDEV_CONFIG"; then
  python3 - "$DDEV_CONFIG" "$REDIS_ENV_VALUE" <<'PYEOF'
import sys, re

config_file = sys.argv[1]
entry = "  - " + sys.argv[2]
text = open(config_file).read()

if re.search(r'^web_environment:', text, re.MULTILINE):
    text = re.sub(
        r'(^web_environment:)',
        r'\1\n' + entry,
        text,
        flags=re.MULTILINE
    )
else:
    text += f'\nweb_environment:\n{entry}\n'

open(config_file, 'w').write(text)
PYEOF
  info "REDIS_ENABLED=true added to web_environment"
else
  warn "REDIS_ENABLED already in web_environment — skipped"
fi

# =============================================================================
# 6. RESTART to pick up new web_environment
# =============================================================================
header "Restarting DDEV"

ddev restart

# =============================================================================
# DONE
# =============================================================================
echo
echo -e "${GREEN}${BOLD}Pantheon setup complete!${RESET}"
echo
echo -e "  ${BOLD}Next steps:${RESET}"
echo -e "  • Connect site on https://dashboard.pantheon.io"
echo -e "  • Add real secrets to ${BOLD}private/pantheon_secrets/secrets.json${RESET}"
echo -e "  • Commit pantheon.yml, settings.platform.php, and quicksilver scripts"
echo
